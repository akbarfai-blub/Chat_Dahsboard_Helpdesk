NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_local_publishable_key
# Aktifkan hanya pada environment prototype
NETWORK_PROVIDER=mock

# Database PostgreSQL connection string untuk server application layer (P1.4 / P2.2)
HELPDESK_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Telegram Inbound Channel Configuration (P2)
TELEGRAM_BOT_ACCOUNT_ID=upaznet_helpdesk_bot
TELEGRAM_TESTER_ALLOWLIST=123456789,987654321
# Secret token untuk verifikasi webhook Telegram (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
