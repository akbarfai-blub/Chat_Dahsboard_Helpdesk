{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "lib/adapters/**/*.ts",
    "lib/application/**/*.ts",
    "lib/domain/**/*.ts",
    "lib/postgres/**/*.ts",
    "lib/providers/**/*.ts",
    "lib/repositories/**/*.ts",
    "lib/supabase/database.types.ts",
    "app/api/webhooks/telegram/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".test-build"
  ]
}
